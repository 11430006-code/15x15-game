
<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>15×15 生存遊戲</title>
<style>
* { box-sizing: border-box; }

body {
  margin: 0;
  min-height: 100vh;
  background: #111827;
  color: white;
  font-family: Arial, "Microsoft JhengHei", sans-serif;
  display: flex;
  justify-content: center;
  align-items: center;
}

.game-container {
  width: 100%;
  max-width: 760px;
  padding: 20px;
  text-align: center;
}

h1 { margin: 0 0 14px; }

.info {
  display: flex;
  justify-content: center;
  gap: 24px;
  margin: 12px 0;
  font-size: 18px;
}

.board-wrapper {
  width: 100%;
  overflow-x: auto;
  padding: 4px;
}

.board {
  display: grid;
  grid-template-columns: repeat(15, 40px);
  grid-template-rows: repeat(15, 40px);
  width: 600px;
  height: 600px;
  aspect-ratio: 1 / 1;
  margin: auto;
  border: 3px solid white;
  background: #1f2937;
}

.cell {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #374151;
  font-size: 23px;
  user-select: none;
}

.player { background: #2563eb; }
.rock { background: #4b5563; }
.wrapped-rock { background: #92400e; }
.monster { background: #7f1d1d; }

.panel {
  margin-top: 14px;
  padding: 14px;
  border: 1px solid #4b5563;
  border-radius: 10px;
  background: #1f2937;
}

.buttons {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 10px;
}

button {
  padding: 10px 14px;
  border: 0;
  border-radius: 8px;
  background: #374151;
  color: white;
  font-size: 15px;
  cursor: pointer;
}

button:hover:not(:disabled) { background: #4b5563; }
button:disabled { opacity: .4; cursor: not-allowed; }

.direction-buttons {
  display: grid;
  grid-template-columns: repeat(3, 55px);
  gap: 5px;
  justify-content: center;
  margin: 12px auto;
}

.direction-buttons button {
  width: 55px;
  height: 45px;
  padding: 0;
  font-size: 21px;
}

.empty { visibility: hidden; }

.inventory {
  margin-top: 12px;
  line-height: 1.9;
}

.status {
  min-height: 24px;
  margin-top: 10px;
  color: #facc15;
}

.overlay {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 10;
  background: #000b;
  justify-content: center;
  align-items: center;
  padding: 20px;
}

.dialog {
  width: min(360px, 100%);
  padding: 28px;
  border-radius: 14px;
  background: #1f2937;
  text-align: center;
}

.dialog h2 { margin-top: 0; }

.help {
  color: #d1d5db;
  font-size: 14px;
  line-height: 1.8;
  margin-top: 14px;
}

@media (max-width: 620px) {
  .game-container { padding: 10px; }
}
</style>
</head>

<body>
<div class="game-container">
  <h1>🎮 15 × 15 生存遊戲</h1>

  <div class="info">
    <div>⭐ 分數：<strong id="score">0</strong></div>
    <div>👣 步數：<strong id="steps">0</strong></div>
  </div>

  <div id="shopMessage">每件裝備需要 50 分</div>

  <div class="board-wrapper">
    <div class="board" id="board"></div>
  </div>

  <div class="panel">
    <strong>🛒 裝備商店｜每件 50 分</strong>
    <div class="buttons">
      <button id="armorButton" onclick="buy('armor')">
        🛡️ 盔甲 50分
      </button>
      <button id="swordButton" onclick="buy('sword')">
        ⚔️ 劍 50分
      </button>
      <button id="clothButton" onclick="buy('cloth')">
        🧣 布 50分
      </button>
    </div>
    <div class="inventory">
      🛡️ 盔甲：<span id="armorCount">0</span>
      <br>
      ⚔️ 劍：<span id="swordCount">0</span> 次攻擊
      <br>
      🧣 布：<span id="clothCount">0</span>
      <br>
      🪨 已包住石頭：<span id="wrappedCount">0</span>
    </div>
  </div>

  <div class="panel">
    <strong>🎮 操作</strong>
    <div class="direction-buttons">
      <button class="empty"></button>
      <button onclick="move(0,-1)">↑</button>
      <button class="empty"></button>
      <button onclick="move(-1,0)">←</button>
      <button onclick="move(0,1)">↓</button>
      <button onclick="move(1,0)">→</button>
    </div>
    <div class="buttons">
      <button onclick="attack()">⚔️ 攻擊（Space）</button>
      <button onclick="togglePause()" id="pauseButton">⏸️ 暫停</button>
      <button onclick="restart()">🔄 重新開始</button>
    </div>
  </div>

  <div class="status" id="status">按下開始遊戲開始冒險！</div>

  <div class="help">
    方向鍵 / WASD：移動<br>
    Space：攻擊相鄰怪物<br>
    撞到邊界或未包住的石頭會死亡
  </div>
</div>

<div class="overlay" id="startOverlay" style="display:flex">
  <div class="dialog">
    <h2>🎮 生存挑戰</h2>
    <p>準備好在 15×15 的世界生存了嗎？</p>
    <button onclick="startGame()">開始遊戲</button>
  </div>
</div>

<div class="overlay" id="endOverlay">
  <div class="dialog">
    <h2>💀 遊戲結束</h2>
    <p id="endReason"></p>
    <p>最終分數：<strong id="finalScore">0</strong></p>
    <button onclick="restart()">重新開始</button>
  </div>
</div>

<script>
const SIZE = 15;
const COST = 50;

let player, rocks, monsters;
let score = 0;
let steps = 0;
let armor = 0;
let sword = 0;
let cloth = 0;
let wrappedRock = null;
let nextClothReset = 50;
let running = false;
let paused = false;
let audio = null;

function initAudio() {
  if (!audio) {
    audio = new (window.AudioContext || window.webkitAudioContext)();
  }
  if (audio.state === "suspended") audio.resume();
}

function tone(freq, duration, type = "sine", volume = 0.12) {
  initAudio();
  const osc = audio.createOscillator();
  const gain = audio.createGain();
  osc.type = type;
  osc.frequency.value = freq;
  gain.gain.setValueAtTime(volume, audio.currentTime);
  gain.gain.exponentialRampToValueAtTime(
    0.001, audio.currentTime + duration
  );
  osc.connect(gain);
  gain.connect(audio.destination);
  osc.start();
  osc.stop(audio.currentTime + duration);
}

function sound(name) {
  if (name === "start") {
    tone(523,.12); setTimeout(()=>tone(659,.12),100);
    setTimeout(()=>tone(784,.2),200);
  } else if (name === "move") {
    tone(320,.045,"square",.055);
  } else if (name === "buy") {
    tone(520,.1); setTimeout(()=>tone(780,.15),100);
  } else if (name === "attack") {
    tone(140,.12,"sawtooth");
  } else if (name === "hit") {
    tone(850,.1); setTimeout(()=>tone(1100,.12),90);
  } else if (name === "death") {
    tone(180,.3,"sawtooth");
    setTimeout(()=>tone(90,.5,"sawtooth"),220);
  }
}

function createBoard() {
  const board = document.getElementById("board");
  board.innerHTML = "";
  for (let y=0; y<SIZE; y++) {
    for (let x=0; x<SIZE; x++) {
      const cell = document.createElement("div");
      cell.className = "cell";
      cell.id = `c-${x}-${y}`;
      board.appendChild(cell);
    }
  }
}

function same(a,b) {
  return a.x===b.x && a.y===b.y;
}

function occupied(x,y) {
  if (player && player.x===x && player.y===y) return true;
  if (rocks.some(r=>r.x===x && r.y===y)) return true;
  if (monsters.some(m=>m.x===x && m.y===y)) return true;
  return false;
}

function randomPosition() {
  let p;
  do {
    p = {
      x: Math.floor(Math.random()*SIZE),
      y: Math.floor(Math.random()*SIZE)
    };
  } while (occupied(p.x,p.y));
  return p;
}

function resetState() {
  player = {x:7,y:7};
  rocks = [];
  monsters = [];
  score = 0;
  steps = 0;
  armor = 0;
  sword = 0;
  cloth = 0;
  wrappedRock = null;
  nextClothReset = 50;
  paused = false;
  running = true;

  for (let i=0;i<3;i++) rocks.push(randomPosition());
  for (let i=0;i<3;i++) monsters.push(randomPosition());

  document.getElementById("startOverlay").style.display="none";
  document.getElementById("endOverlay").style.display="none";
  document.getElementById("pauseButton").textContent="⏸️ 暫停";
  document.getElementById("status").textContent="冒險開始！";
  update();
}

function startGame() {
  initAudio();
  resetState();
  sound("start");
}

function restart() {
  initAudio();
  resetState();
  sound("start");
}

function update() {
  document.getElementById("score").textContent=score;
  document.getElementById("steps").textContent=steps;
  document.getElementById("armorCount").textContent=armor;
  document.getElementById("swordCount").textContent=sword;
  document.getElementById("clothCount").textContent=cloth;
  document.getElementById("wrappedCount").textContent=wrappedRock?1:0;

  for (let y=0;y<SIZE;y++) {
    for (let x=0;x<SIZE;x++) {
      const c=document.getElementById(`c-${x}-${y}`);
      c.textContent="";
      c.className="cell";
    }
  }

  for (const r of rocks) {
    const c=document.getElementById(`c-${r.x}-${r.y}`);
    if (wrappedRock && same(r,wrappedRock)) {
      c.textContent="🧣";
      c.classList.add("wrapped-rock");
    } else {
      c.textContent="🪨";
      c.classList.add("rock");
    }
  }

  for (const m of monsters) {
    const c=document.getElementById(`c-${m.x}-${m.y}`);
    c.textContent="👾";
    c.classList.add("monster");
  }

  const p=document.getElementById(`c-${player.x}-${player.y}`);
  p.textContent="🙂";
  p.classList.add("player");

  for (const id of ["armorButton","swordButton","clothButton"]) {
    document.getElementById(id).disabled = !running || paused || score<COST;
  }

  document.getElementById("shopMessage").textContent =
    score>=COST ? "可以購買裝備！每件消耗 50 分" :
    `還差 ${COST-score} 分即可購買裝備`;
}

function buy(type) {
  if (!running || paused || score<COST) return;
  score -= COST;

  if (type==="armor") armor++;
  if (type==="sword") sword += 3;
  if (type==="cloth") {
    cloth++;
    wrappedRock = null;
    nextClothReset = Math.floor(score/50)*50+50;
  }

  sound("buy");
  document.getElementById("status").textContent="購買成功！";
  update();
}

function gainStep() {
  score++;
  steps++;

  if (wrappedRock && score>=nextClothReset) {
    wrappedRock=null;
    nextClothReset=Math.floor(score/50)*50+50;
    document.getElementById("status").textContent="布的保護效果已到期！";
  }
}

function die(reason) {
  if (!running) return;
  running=false;
  sound("death");
  document.getElementById("endReason").textContent=reason;
  document.getElementById("finalScore").textContent=score;
  document.getElementById("endOverlay").style.display="flex";
  update();
}

function move(dx,dy) {
  if (!running || paused) return;
  initAudio();

  const nx=player.x+dx;
  const ny=player.y+dy;

  if (nx<0 || nx>=SIZE || ny<0 || ny>=SIZE) {
    die("你碰到了邊界！");
    return;
  }

  const rock=rocks.find(r=>r.x===nx && r.y===ny);
  if (rock) {
    if (wrappedRock && same(rock,wrappedRock)) {
      // 已包住的石頭可以通過
    } else if (cloth>0) {
      cloth--;
      wrappedRock={x:rock.x,y:rock.y};
      document.getElementById("status").textContent="你用布包住了石頭！";
    } else {
      die("你撞到了石頭！");
      return;
    }
  }

  const monsterIndex=monsters.findIndex(m=>m.x===nx && m.y===ny);
  if (monsterIndex!==-1) {
    if (armor>0) {
      armor--;
      // 盔甲擋住碰撞，怪物被推回玩家原本的位置
      monsters[monsterIndex]={x:player.x,y:player.y};
      document.getElementById("status").textContent="盔甲抵擋了一次攻擊！";
    } else {
      die("你撞到了怪物！");
      return;
    }
  }

  player={x:nx,y:ny};
  gainStep();
  sound("move");

  moveMonsters();
  if (!running) return;

  update();
}

function moveMonsters() {
  const dirs=[
    {x:0,y:-1},{x:0,y:1},
    {x:-1,y:0},{x:1,y:0}
  ];

  // 先計算每隻怪物的移動，避免怪物重疊
  const reserved = new Set(
    monsters.map(m=>`${m.x},${m.y}`)
  );

  for (const m of monsters) {
    reserved.delete(`${m.x},${m.y}`);

    const shuffled=[...dirs].sort(()=>Math.random()-.5);
    for (const d of shuffled) {
      const nx=m.x+d.x, ny=m.y+d.y;
      if (nx<0 || nx>=SIZE || ny<0 || ny>=SIZE) continue;
      if (rocks.some(r=>r.x===nx && r.y===ny)) continue;
      if (reserved.has(`${nx},${ny}`)) continue;

      if (nx===player.x && ny===player.y) {
        if (armor>0) {
          armor--;
          document.getElementById("status").textContent="盔甲抵擋了怪物攻擊！";
          // 怪物留在原地
          reserved.add(`${m.x},${m.y}`);
          break;
        } else {
          die("怪物追上你了！");
          return;
        }
      }

      m.x=nx;
      m.y=ny;
      reserved.add(`${m.x},${m.y}`);
      break;
    }
  }
}

function attack() {
  if (!running || paused) return;
  initAudio();

  if (sword<=0) {
    document.getElementById("status").textContent="你沒有可用的劍！";
    return;
  }

  sword--;
  sound("attack");

  const index=monsters.findIndex(m=>
    Math.abs(m.x-player.x)+Math.abs(m.y-player.y)===1
  );

  if (index>=0) {
    monsters.splice(index,1);
    sound("hit");
    document.getElementById("status").textContent="成功擊敗一隻怪物！";
  } else {
    document.getElementById("status").textContent="攻擊沒有命中怪物！";
  }

  update();
}

function togglePause() {
  if (!running) return;
  paused=!paused;
  document.getElementById("pauseButton").textContent=
    paused ? "▶️ 繼續" : "⏸️ 暫停";
  document.getElementById("status").textContent=
    paused ? "遊戲暫停中" : "繼續冒險！";
  update();
}

document.addEventListener("keydown",e=>{
  if (!running || paused) return;

  const key=e.key.toLowerCase();

  if (["arrowup","arrowdown","arrowleft","arrowright"," "].includes(key)) {
    e.preventDefault();
  }

  if (key==="arrowup" || key==="w") move(0,-1);
  else if (key==="arrowdown" || key==="s") move(0,1);
  else if (key==="arrowleft" || key==="a") move(-1,0);
  else if (key==="arrowright" || key==="d") move(1,0);
  else if (e.code==="Space") attack();
});

createBoard();
update();
</script>
</body>
</html>
